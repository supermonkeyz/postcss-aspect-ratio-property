{
  "name": "postcss-aspect-ratio-property",
  "version": "1.0.0",
  "description": "PostCSS plugin CSS4 aspect-ratio property",
  "keywords": [
    "postcss",
    "css",
    "css4",
    "postcss-plugin",
    "aspect-ratio",
    "postcss-aspect-ratio"
  ],
  "main": "dist/index.js",
  "scripts": {
    "test": "jest-ci --coverage && eslint-ci .",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "author": "supermonkeyz <popbaby@qq.com>",
  "license": "MIT",
  "repository": "supermonkeyz/postcss-aspect-ratio-property",
  "engines": {
    "node": ">=10.0.0"
  },
  "peerDependencies": {
    "postcss": "^8.1.0"
  },
  "dependencies": {
    "@types/mathjs": "^9.4.2",
    "mathjs": "^8.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.1",
    "clean-publish": "^5.2.2",
    "eslint": "^7.10.0",
    "eslint-ci": "^1.0.0",
    "eslint-plugin-jest": "^24.0.2",
    "husky": "^4.3.0",
    "jest": "^30.0.0",
    "jest-ci": "^0.1.1",
    "jest-cli": "^30.0.0",
    "lint-staged": "^10.4.0",
    "postcss": "^8.5.5",
    "typescript": "^5.8.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": "eslint --fix"
  },
  "eslintConfig": {
    "parserOptions": {
      "ecmaVersion": 2017
    },
    "env": {
      "node": true,
      "es6": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:jest/recommended"
    ],
    "rules": {
      "jest/expect-expect": "off"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "statements": 100
      }
    }
  }
}
